# Telegram delivery for the contact form (server-side only)
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=

# Absolute origin used for canonical, og:url, hreflang and the sitemap
NUXT_PUBLIC_SITE_URL=https://dadashi44.vercel.app

# PostHog analytics (pageviews, clicks, geo). Leave empty to disable.
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Channel whose pinned PDF is served as /resume.pdf (the bot must be an admin there)
NUXT_TELEGRAM_RESUME_CHAT_ID=
